# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Site
SITE_NAME="Sergio's Corner"
THEME_BACKGROUND=#ffffff       # page background
THEME_FOREGROUND=#111827       # main text — must contrast with background
THEME_MUTED=#6b7280            # secondary text
THEME_BORDER=#e5e7eb           # general border color
THEME_PRIMARY=#111827          # site title / brand color
THEME_BANNER=#555555           # page banner background
THEME_BANNER_FG=#ffffff        # page banner title text — must contrast with THEME_BANNER
THEME_MAIN_BG=#ffffff          # main content box background
THEME_MAIN_BORDER=#e5e7eb      # main content box border
THEME_SURFACE=#ffffff          # nav and footer background
THEME_SURFACE_FG=#111827       # nav and footer text color
THEME_SURFACE_BORDER=#e5e7eb  # nav and footer border color
THEME_NAV_ACTIVE=#111827       # active nav item background
THEME_CARD=#ffffff             # card background (e.g. team listing cards)
THEME_FONT_FAMILY=             # custom font family (leave empty for system font)

# PostgreSQL
POSTGRES_DB=truqui_center
POSTGRES_USER=truqui
POSTGRES_PASSWORD=truqui
POSTGRES_HOST=db
POSTGRES_PORT=5432
